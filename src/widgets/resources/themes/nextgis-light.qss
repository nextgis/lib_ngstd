    border-color: #FFFFFF;
    color: #FFFFFF;
}

QPushButton[ngstdButtonVariant="photo"]:hover {
background: rgba(0, 0, 0, 0.44);
    border-color: transparent;
    color: #FFFFFF;
}

QPushButton[ngstdButtonVariant="photo"]:pressed {
