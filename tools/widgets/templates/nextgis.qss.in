/* Generated NextGIS UI Style Reference for Qt 5.15, {{theme}} theme. */

QWidget {
    color: {{text}};
    font-family: "{{qtBodyFamily}}", "Segoe UI", sans-serif;
    font-size: {{qtBodySize}}px;
    font-weight: {{qtBodyWeight}};
}

QLabel {
    background: transparent;
}

QToolButton {
    min-height: {{controlContentHeightMedium}}px;
    padding: 0 {{controlPaddingX}}px;
    border: 1px solid {{borderStrong}};
    border-radius: {{buttonRadius}}px;
    background: {{surface}};
    color: {{text}};
    font-weight: 500;
}

QToolButton:hover {
    background: {{surfaceBrand}};
    border-color: {{brandHover}};
    color: {{linkHover}};
}

QToolButton:pressed {
    background: {{brandSoft}};
    border-color: {{brandActive}};
    color: {{brandActive}};
}

QToolButton:disabled {
    background: {{surfaceMuted}};
    border-color: {{border}};
    color: {{textDisabled}};
}

QLineEdit QToolButton[_ngstdRole="fieldAction"] {
    min-width: {{controlIconSize}}px;
    max-width: {{controlIconSize}}px;
    min-height: {{controlIconSize}}px;
    max-height: {{controlIconSize}}px;
    padding: 0;
    border: 0;
    background: transparent;
}

QWidget[_ngstdRole="page"] {
    background: {{pageSoft}};
}

QFrame[_ngstdRole="galleryHeader"] {
    background: {{header}};
    border: 0;
    border-bottom: 1px solid {{border}};
}

QLabel[_ngstdRole="separator"] {
    background: {{border}};
}

QFrame[_ngstdRole="themeSwitch"] {
    background: {{surfaceMuted}};
    border: 1px solid {{border}};
    border-radius: 10px;
}

QToolButton[_ngstdRole="themeButton"] {
    min-width: {{themeSwitchButtonWidth}}px;
    max-width: {{themeSwitchButtonWidth}}px;
    min-height: {{themeSwitchButtonHeight}}px;
    max-height: {{themeSwitchButtonHeight}}px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: {{themeSwitchIndicatorRadius}}px;
}

QToolButton[_ngstdRole="themeButton"]:hover {
    background: {{surfaceBrand}};
}

QToolButton[_ngstdRole="themeButton"]:checked {
    background: transparent;
}

QToolButton[_ngstdRole="themeButton"]:pressed,
QToolButton[_ngstdRole="themeButton"]:checked:pressed {
    background: {{brandActive}};
}

QToolButton[_ngstdRole="themeButton"]:checked:hover {
    background: transparent;
}

QFrame[_ngstdRole="quickNavigation"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{panelRadius}}px;
}

QFrame[_ngstdRole="quickLink"] {
    background: transparent;
    border: 0;
    border-radius: 7px;
}

QFrame[_ngstdRole="quickLink"]:hover {
    background: {{surfaceBrand}};
}

QFrame[_ngstdRole="quickLink"][pressed="true"] {
    background: {{brandSoft}};
}

QFrame[_ngstdRole="quickLink"]:disabled {
    background: transparent;
}

QFrame[_ngstdRole="quickLink"]:disabled
QLabel[_ngstdRole="navigationNumber"],
QFrame[_ngstdRole="quickLink"]:disabled
QLabel[_ngstdRole="navigationText"],
QFrame[_ngstdRole="quickLink"]:disabled
QLabel[_ngstdRole="navigationArrow"] {
    color: {{textDisabled}};
}

QFrame[_ngstdRole="quickLink"][pressed="true"]
QLabel[_ngstdRole="navigationText"],
QFrame[_ngstdRole="quickLink"][pressed="true"]
QLabel[_ngstdRole="navigationArrow"] {
    color: {{brandActive}};
}

QFrame[_ngstdRole="cardIcon"],
QLabel[_ngstdRole="cardIcon"] {
    border: 0;
    border-radius: 0;
    background: transparent;
}

QLabel[_ngstdRole="secondary"] {
    background: transparent;
    color: {{textSecondary}};
}

QLabel[_ngstdRole="toggleState"] {
    min-width: {{toggleStateContentWidth}}px;
    max-width: {{toggleStateContentWidth}}px;
    min-height: {{toggleStateContentHeight}}px;
    max-height: {{toggleStateContentHeight}}px;
    padding: 0 9px;
    border: 0;
    border-radius: {{toggleStateRadius}}px;
    background: {{surfaceMuted}};
    color: {{textMuted}};
    font-size: {{typeCaptionSize}}px;
    font-weight: {{typeCaptionWeight}};
}

QLabel[_ngstdRole="toggleState"][active="true"] {
    background: {{brandSoft}};
    color: {{link}};
}

QLabel[_ngstdRole="eyebrow"] {
    background: transparent;
    color: {{link}};
    font-family: "{{qtBodyFamily}}", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 700;
}

QLabel[_ngstdRole="heroTitle"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: 54px;
    font-weight: 700;
}

QLabel[_ngstdRole="heroLead"] {
    background: transparent;
    color: {{textSecondary}};
    font-family: "{{qtBodyFamily}}", "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 400;
}

QLabel[_ngstdRole="navigationLabel"] {
    background: transparent;
    color: {{textMuted}};
    font-size: 12px;
    font-weight: 700;
}

QLabel[_ngstdRole="navigationNumber"] {
    background: transparent;
    color: {{link}};
    font-family: "{{qtMonoFamily}}", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
}

QLabel[_ngstdRole="navigationText"] {
    background: transparent;
    color: {{textSecondary}};
    font-size: 13px;
    font-weight: 500;
}

QLabel[_ngstdRole="navigationArrow"] {
    background: transparent;
    color: {{textMuted}};
    font-size: 15px;
}

QLabel[_ngstdRole="panelHeading"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 700;
}

QFrame[_ngstdRole="componentPanel"] {
    background: {{surfaceNested}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
}

QFrame[_ngstdRole="semanticState"] {
    border: 1px solid {{link}};
    border-radius: {{cardRadius}}px;
    background: {{surfaceBrand}};
}

QFrame[_ngstdRole="semanticState"][ngstdTone="success"] {
    border-color: {{success}};
    background: {{successSoft}};
}

QFrame[_ngstdRole="semanticState"][ngstdTone="warning"] {
    border-color: {{warning}};
    background: {{warningSoft}};
}

QFrame[_ngstdRole="semanticState"][ngstdTone="danger"] {
    border-color: {{danger}};
    background: {{dangerSoft}};
}

QToolButton[_ngstdRole="semanticCopy"] {
    min-height: 30px;
    padding: 0;
    border: 0;
    border-radius: {{fieldRadius}}px;
    background: transparent;
    color: {{textSecondary}};
}

QToolButton[_ngstdRole="semanticCopy"]:hover {
    background: {{referenceSemanticHover}};
}

QToolButton[_ngstdRole="semanticCopy"]:pressed {
    background: {{referenceSemanticActive}};
}

QLabel[_ngstdRole="semanticToken"] {
    color: {{text}};
    font-family: "{{qtMonoFamily}}", "Consolas", monospace;
    font-size: 11px;
}

QLabel[_ngstdRole="semanticValue"] {
    font-family: "{{qtMonoFamily}}", "Consolas", monospace;
    font-size: 11px;
}

QLabel[_ngstdRole="semanticTitle"] {
    color: {{link}};
    font-size: 14px;
    font-weight: 700;
}

QLabel[_ngstdRole="semanticTitle"][ngstdTone="success"] {
    color: {{success}};
}

QLabel[_ngstdRole="semanticTitle"][ngstdTone="warning"] {
    color: {{warning}};
}

QLabel[_ngstdRole="semanticTitle"][ngstdTone="danger"] {
    color: {{danger}};
}

QFrame[_ngstdRole="sampleStage"] {
    background: {{surfaceBrand}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
}

QLabel[_ngstdRole="typeStageDisplay"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: {{galleryTypeStageDisplaySize}}px;
    font-weight: 700;
}

QFrame[_ngstdRole="typeScale"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
}

QFrame[_ngstdRole="typeSpecimen"] {
    background: {{surface}};
    border: 0;
    border-bottom: 1px solid {{border}};
}

QFrame[_ngstdRole="typeSpecimen"][last="true"] {
    border-bottom: 0;
}

QFrame[_ngstdRole="nestedPanel"] {
    background: {{surfaceNested}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
}

QFrame[_ngstdRole="privateShowcase"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{buttonRadius}}px;
}

QFrame[_ngstdRole="backgroundCaption"] {
    background: {{surface}};
    border: 0;
    border-top: 1px solid {{border}};
    border-bottom-left-radius: {{panelRadius}}px;
    border-bottom-right-radius: {{panelRadius}}px;
}

QFrame[_ngstdRole="pageBackground"],
QWidget[_ngstdRole="pageBackground"] {
    background: {{background}};
    color: {{text}};
}

QFrame[_ngstdRole="pageBackground"][_ngstdCornerMode="roundedTop"] {
    border-top-left-radius: {{panelRadius}}px;
    border-top-right-radius: {{panelRadius}}px;
}

QFrame[_ngstdRole="pageBackground"][_ngstdCornerMode="rounded"] {
    border-radius: {{panelRadius}}px;
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"] {
    background: qlineargradient(
        x1: 0, y1: 1, x2: 0, y2: 0,
        stop: 0 {{pageSoft}},
        stop: 0.95 {{background}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="none"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="none"] {
    background: {{background}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="up"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="up"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{pageSoft}},
        stop: 0.95 {{background}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="center"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="center"] {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 {{background}},
        stop: 1 {{pageSoft}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="toCenter"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="main"][_ngstdGradient="toCenter"] {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 {{pageSoft}},
        stop: 1 {{background}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="workspace"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="workspace"] {
    background: {{pageSoft}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{toolboxGradientStrong}},
        stop: 1 {{toolboxGradientClear}}
    );
    color: {{toolboxText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="none"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="none"] {
    background: {{toolboxSurface}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="up"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="up"] {
    background: qlineargradient(
        x1: 0, y1: 1, x2: 0, y2: 0,
        stop: 0 {{toolboxGradientStrong}},
        stop: 1 {{toolboxGradientClear}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="center"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="center"] {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 {{toolboxGradientClear}},
        stop: 1 {{toolboxGradientStrong}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="toCenter"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdGradient="toCenter"] {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 {{toolboxGradientStrong}},
        stop: 1 {{toolboxGradientClear}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"][_ngstdPaintedBackground="true"] {
    background: {{toolboxSurface}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="data"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="data"] {
    background: {{dataSurface}};
    color: {{dataText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"] {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 {{corporateGradientClear}},
        stop: 1 {{corporateGradientStrong}}
    );
    color: {{corporateText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="none"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="none"] {
    background: {{corporateSurface}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="down"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="down"] {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 {{corporateGradientStrong}},
        stop: 1 {{corporateGradientClear}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="up"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="up"] {
    background: qlineargradient(
        x1: 0, y1: 1, x2: 0, y2: 0,
        stop: 0 {{corporateGradientStrong}},
        stop: 1 {{corporateGradientClear}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="toCenter"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"][_ngstdGradient="toCenter"] {
    background: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.8,
        fx: 0.5, fy: 0.5,
        stop: 0 {{corporateGradientStrong}},
        stop: 1 {{corporateGradientClear}}
    );
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="fieldwork"],
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="fieldwork"] {
    background: {{fieldworkSurface}};
    color: {{fieldworkText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"] QLabel,
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="toolbox"] QLabel {
    color: {{toolboxText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="data"] QLabel,
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="data"] QLabel {
    color: {{dataText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"] QLabel,
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="corporate"] QLabel {
    color: {{corporateText}};
}

QFrame[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="fieldwork"] QLabel,
QWidget[_ngstdRole="pageBackground"][ngstdPageBackgroundVariant="fieldwork"] QLabel {
    color: {{fieldworkText}};
}

QFrame[_ngstdRole="panel"],
QWidget[_ngstdRole="panel"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{panelRadius}}px;
}

QFrame[_ngstdRole="card"],
QWidget[_ngstdRole="card"] {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
}

QFrame[_ngstdRole="card"][_ngstdDisclosureAnimating="true"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"],
QWidget[_ngstdRole="card"][_ngstdPaintedCard="true"] {
    border-color: transparent;
}

QFrame[_ngstdRole="card"][ngstdCardVariant="panel"],
QWidget[_ngstdRole="card"][ngstdCardVariant="panel"] {
    border-radius: {{panelRadius}}px;
}

QFrame[_ngstdRole="card"][ngstdSelected="true"],
QWidget[_ngstdRole="card"][ngstdSelected="true"] {
    background: {{surfaceBrand}};
    border-color: {{focus}};
}

QFrame[_ngstdRole="card"][interactive="true"]:hover,
QWidget[_ngstdRole="card"][interactive="true"]:hover {
    background: {{surfaceBrand}};
    border-color: {{brandHover}};
}

QFrame[_ngstdRole="card"][interactive="true"][pressed="true"],
QWidget[_ngstdRole="card"][interactive="true"][pressed="true"] {
    background: {{brandSoft}};
    border-color: {{brandActive}};
}

QFrame[_ngstdRole="card"][ngstdCardVariant="data"],
QWidget[_ngstdRole="card"][ngstdCardVariant="data"] {
    border-color: {{dataBorder}};
    border-radius: {{fieldRadius}}px;
}

QFrame[_ngstdRole="card"][ngstdCardVariant="data"][interactive="true"]:hover,
QWidget[_ngstdRole="card"][ngstdCardVariant="data"][interactive="true"]:hover {
    background: {{dataOutlineHoverBackground}};
    border-color: {{dataBorder}};
}

QFrame[_ngstdRole="card"][ngstdCardVariant="data"][interactive="true"][pressed="true"],
QWidget[_ngstdRole="card"][ngstdCardVariant="data"][interactive="true"][pressed="true"] {
    background: {{dataOutlinePressedBackground}};
    border-color: {{dataBorder}};
}

QFrame[_ngstdRole="card"][ngstdCardVariant="toolbox"],
QWidget[_ngstdRole="card"][ngstdCardVariant="toolbox"],
QFrame[_ngstdRole="card"][ngstdCardVariant="toolboxNew"],
QWidget[_ngstdRole="card"][ngstdCardVariant="toolboxNew"] {
    border: 0;
    border-radius: {{buttonRadius}}px;
    background: {{toolboxCardSurface}};
}

QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][interactive="true"]:hover,
QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][interactive="true"][pressed="true"] {
    border-color: transparent;
    background: {{surface}};
}

QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][ngstdCardVariant="toolbox"][interactive="true"]:hover,
QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][ngstdCardVariant="toolbox"][interactive="true"][pressed="true"],
QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][ngstdCardVariant="toolboxNew"][interactive="true"]:hover,
QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][ngstdCardVariant="toolboxNew"][interactive="true"][pressed="true"] {
    border-color: transparent;
    background: {{toolboxCardSurface}};
}

QFrame[_ngstdRole="card"][_ngstdPaintedCard="true"][ngstdCardVariant="toolboxNew"] {
    border-color: transparent;
}

QFrame[_ngstdRole="card"][ngstdCardVariant="toolbox"][interactive="true"]:hover,
QWidget[_ngstdRole="card"][ngstdCardVariant="toolbox"][interactive="true"]:hover {
    background: {{toolboxCardSurface}};
}

QFrame[_ngstdRole="card"][ngstdCardVariant="toolbox"][interactive="true"][pressed="true"],
QWidget[_ngstdRole="card"][ngstdCardVariant="toolbox"][interactive="true"][pressed="true"] {
    border: 0;
    background: {{toolboxCardSurface}};
}

QFrame[_ngstdRole="card"][ngstdCardVariant="toolboxNew"][interactive="true"][pressed="true"],
QWidget[_ngstdRole="card"][ngstdCardVariant="toolboxNew"][interactive="true"][pressed="true"] {
    border: 2px solid {{toolboxAccent}};
}

QFrame[_ngstdRole="card"][ngstdCardVariant="toolboxNew"],
QWidget[_ngstdRole="card"][ngstdCardVariant="toolboxNew"] {
    border: 2px solid {{toolboxAccent}};
}

QLabel[_ngstdRole="sourceCardLabel"] {
    background: transparent;
    color: {{textMuted}};
    font-size: 12px;
    font-weight: 500;
}

QLabel[_ngstdRole="dataCardTitle"] {
    background: transparent;
    color: {{dataText}};
    font-family: "{{qtHeadingFamily}}", "{{qtBodyFamily}}", sans-serif;
    font-size: 18px;
    font-weight: 500;
}

QLabel[_ngstdRole="dataCardDescription"] {
    background: transparent;
    color: {{dataText}};
    font-size: 14px;
    font-weight: 400;
}

QLabel[_ngstdRole="toolboxTag"] {
    padding: 1px 7px;
    border: 1px solid {{toolboxAccent}};
    border-radius: 4px;
    background: {{toolboxSurface}};
    color: {{toolboxAccent}};
    font-size: 12px;
    font-weight: 400;
}

QLabel[_ngstdRole="toolboxTag"][featured="true"] {
    border-color: {{toolboxTagFeaturedBorder}};
    background: {{toolboxTagFeaturedSurface}};
    color: {{toolboxTagFeaturedText}};
}

QLabel[_ngstdRole="toolboxCardTitle"] {
    background: transparent;
    color: {{toolboxText}};
    font-family: "{{qtHeadingFamily}}", "{{qtBodyFamily}}", sans-serif;
    font-size: 22px;
    font-weight: 700;
}

QLabel[_ngstdRole="toolboxCardBody"] {
    background: transparent;
    color: {{toolboxText}};
    font-family: "{{qtHeadingFamily}}", "{{qtBodyFamily}}", sans-serif;
    font-size: 16px;
    font-weight: 400;
}

QLabel[_ngstdRole="onImageTitle"] {
    background: transparent;
    color: {{white}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: 18px;
    font-weight: 700;
}

QLabel[_ngstdRole="onImageBody"] {
    background: transparent;
    color: {{corporateText}};
    font-size: 14px;
    font-weight: 400;
}

QLabel[_ngstdRole="heading1"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: {{qtHeading1Size}}px;
    font-weight: {{qtHeading1Weight}};
}

QLabel[_ngstdRole="heading2"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: {{qtHeading2Size}}px;
    font-weight: {{qtHeading2Weight}};
}

QLabel[ngstdTypographyRole="display"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: {{typeDisplaySize}}px;
    font-weight: {{typeDisplayWeight}};
}

QLabel[ngstdTypographyRole="heading1"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
