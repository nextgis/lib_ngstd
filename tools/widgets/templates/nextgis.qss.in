}

QWidget[_ngstdRole="disclosureContent"] {
    border: 0;
    background: transparent;
    color: {{textSecondary}};
}

QTextEdit,
QPlainTextEdit {
    min-height: {{controlContentHeightMedium}}px;
    padding: 0 {{space3}}px;
    border: 1px solid {{borderStrong}};
    border-radius: {{fieldRadius}}px;
    background: {{surface}};
    color: {{text}};
    selection-background-color: {{brand}};
    selection-color: {{white}};
}

QTextEdit:hover,
QPlainTextEdit:hover {
    border-color: {{brandHover}};
}

QTextEdit[ngstdError="true"],
QPlainTextEdit[ngstdError="true"] {
    border-color: {{danger}};
    background: {{dangerSoft}};
}

QTextEdit:disabled,
QPlainTextEdit:disabled {
    border-color: {{border}};
    background: {{surfaceMuted}};
    color: {{textDisabled}};
}

QComboBox QAbstractItemView {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: {{textSecondary}};
    outline: 0;
    selection-background-color: transparent;
    selection-color: {{text}};
}

QComboBox QAbstractItemView::item {
    min-height: {{comboBoxPopupItemHeight}}px;
    padding: 0 {{comboBoxPopupItemPaddingHorizontal}}px;
    border: 0;
    border-radius: {{fieldRadius}}px;
    color: {{textSecondary}};
}

QComboBox QAbstractItemView::item:disabled {
    color: {{textDisabled}};
}

QComboBox QAbstractItemView::item:hover {
    background: {{surfaceBrand}};
    color: {{link}};
}

QComboBox QAbstractItemView::item:selected {
    background: {{surfaceBrand}};
    color: {{link}};
    font-weight: 500;
}

QComboBox QAbstractItemView::item:selected:hover {
    background: {{surfaceBrand}};
    color: {{link}};
}

QComboBoxPrivateContainer {
    border: 0;
    border-radius: 0;
    background: transparent;
}

QTabWidget::pane {
    border: 0;
    border-top: 1px solid {{border}};
}

QAbstractItemView {
    border: 1px solid {{border}};
    border-radius: {{cardRadius}}px;
    background: {{surface}};
    alternate-background-color: {{surfaceMuted}};
    color: {{text}};
    outline: 0;
    selection-background-color: {{brandSoft}};
    selection-color: {{link}};
}

QListView {
    padding: 5px;
}

QTreeView {
    padding: 5px;
}

QListView::item {
    min-height: {{itemViewRowHeight}}px;
    padding: 0 {{itemViewCellPaddingHorizontal}}px;
    border: 0;
    border-radius: {{fieldRadius}}px;
}

QListView::item:hover {
    background: {{surfaceBrand}};
}

QListView::item:selected {
    background: {{brandSoft}};
    color: {{link}};
}

QHeaderView::section {
    min-height: {{tableHeaderHeight}}px;
    padding: 0 {{tableCellPaddingHorizontal}}px;
    border: 0;
    border-bottom: 1px solid {{border}};
    background: {{surfaceMuted}};
    color: {{textSecondary}};
    font-weight: 500;
}

QTableView,
QTableWidget {
    gridline-color: {{border}};
}

QTableWidget[_ngstdPaintedTable="true"] {
    border: 0;
}

QTableWidget[_ngstdPaintedTable="true"]::item {
    padding: 0;
}

QTableView::item,
QTableWidget::item {
    min-height: {{tableRowHeight}}px;
    padding: {{tableCellPaddingVertical}}px {{tableCellPaddingHorizontal}}px;
    border: 0;
    border-bottom: 1px solid {{border}};
}

QTableView QWidget[_ngstdRole="tableViewport"],
QTableWidget QWidget[_ngstdRole="tableViewport"] {
    background: {{surface}};
    border: 0;
}

QScrollBar:vertical {
    width: {{scrollBarExtent}}px;
    margin: {{scrollBarMargin}}px;
    border: 0;
    background: {{pageSoft}};
}

QScrollBar:horizontal {
    height: {{scrollBarExtent}}px;
    margin: {{scrollBarMargin}}px;
    border: 0;
    background: {{pageSoft}};
}

QScrollBar::groove:vertical,
QScrollBar::groove:horizontal {
    border: 0;
    background: {{pageSoft}};
}

QAbstractItemView QScrollBar:vertical,
QAbstractItemView QScrollBar:horizontal,
QAbstractItemView QScrollBar::groove:vertical,
QAbstractItemView QScrollBar::groove:horizontal {
    background: {{surface}};
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    min-width: {{scrollBarMinimumThumb}}px;
    min-height: {{scrollBarMinimumThumb}}px;
    border: 0;
    border-radius: {{scrollBarRadius}}px;
    background: {{borderStrong}};
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: {{textMuted}};
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: {{scrollBarPressed}};
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    border: 0;
    background: transparent;
}

QAbstractScrollArea::corner {
    border: 0;
    background: transparent;
}

QAbstractItemView[_ngstdComboBoxPopupView="true"] {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: {{textSecondary}};
    outline: 0;
    selection-background-color: transparent;
    selection-color: {{text}};
    padding: 0;
}

QAbstractItemView[_ngstdComboBoxPopupView="true"]::item {
    min-height: {{comboBoxPopupItemHeight}}px;
    padding: 0 {{comboBoxPopupItemPaddingHorizontal}}px;
    border: 0;
    border-radius: {{fieldRadius}}px;
    color: {{textSecondary}};
}

QAbstractItemView[_ngstdComboBoxPopupView="true"]::item:disabled {
    color: {{textDisabled}};
}

QAbstractItemView[_ngstdComboBoxPopupView="true"]::item:hover {
    background: {{surfaceBrand}};
    color: {{link}};
}

QAbstractItemView[_ngstdComboBoxPopupView="true"]::item:selected {
    background: {{surfaceBrand}};
    color: {{link}};
    font-weight: 500;
}

QAbstractItemView[_ngstdComboBoxPopupView="true"]::item:selected:hover {
    background: {{surfaceBrand}};
    color: {{link}};
}

QFrame[_ngstdRole="notice"] {
    padding: {{noticePaddingVertical}}px {{noticePaddingHorizontal}}px;
    border: 1px solid {{border}};
    border-left: {{noticeAccentWidth}}px solid {{link}};
    border-radius: {{buttonRadius}}px;
    background: {{surfaceBrand}};
    color: {{textSecondary}};
}

QFrame[_ngstdRole="notice"][ngstdTone="success"] {
    border-left-color: {{success}};
    background: {{successSoft}};
}

QFrame[_ngstdRole="notice"][ngstdTone="warning"] {
    border-left-color: {{warning}};
    background: {{warningSoft}};
}

QFrame[_ngstdRole="notice"][ngstdTone="danger"] {
    border-left-color: {{danger}};
    background: {{dangerSoft}};
}

QProgressBar {
    min-height: {{progressHeight}}px;
    max-height: {{progressHeight}}px;
    border: 0;
    border-radius: {{progressRadius}}px;
