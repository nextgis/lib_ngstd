QLabel[ngstdTypographyRole="body"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtBodyFamily}}", "Segoe UI", sans-serif;
    font-size: {{typeBodySize}}px;
    font-weight: {{typeBodyWeight}};
}

QLabel[ngstdTypographyRole="control"] {
    background: transparent;
    color: {{text}};
    font-family: "{{qtBodyFamily}}", "Segoe UI", sans-serif;
    font-size: {{typeControlSize}}px;
    font-weight: {{typeControlWeight}};
}

QLabel[ngstdTypographyRole="caption"] {
    background: transparent;
    color: {{textMuted}};
    font-family: "{{qtBodyFamily}}", "Segoe UI", sans-serif;
    font-size: {{typeCaptionSize}}px;
    font-weight: {{typeCaptionWeight}};
}

QLabel[ngstdTypographyRole="mono"],
QWidget[ngstdTypographyRole="mono"] {
    background: transparent;
    color: {{textMuted}};
    font-family: "{{qtMonoFamily}}", "Consolas", monospace;
    font-size: {{qtMonoSize}}px;
    font-weight: {{qtMonoWeight}};
}

QLabel[_ngstdRole="muted"] {
    background: transparent;
    color: {{textMuted}};
}

QLabel[_ngstdRole="success"] {
    background: transparent;
    color: {{success}};
}

QLabel[_ngstdRole="warning"] {
    background: transparent;
    color: {{warning}};
}

QLabel[_ngstdRole="danger"] {
    background: transparent;
    color: {{danger}};
}

QLabel[_ngstdRole="tag"] {
    min-height: {{tagContentHeight}}px;
    padding: 0 {{tagPaddingHorizontal}}px;
    border: 1px solid {{border}};
    border-radius: 14px;
    background: {{surfaceMuted}};
    color: {{textSecondary}};
    font-size: 12px;
    font-weight: 500;
}

QLabel[_ngstdRole="tag"][ngstdTone="info"] {
    border-color: transparent;
    background: {{brandSoft}};
    color: {{link}};
}

QLabel[_ngstdRole="tag"][ngstdTone="success"] {
    border-color: transparent;
    background: {{successSoft}};
    color: {{success}};
}

QLabel[_ngstdRole="tag"][ngstdTone="warning"] {
    border-color: transparent;
    background: {{warningSoft}};
    color: {{warning}};
}

QLabel[_ngstdRole="tag"][ngstdTone="danger"] {
    border-color: transparent;
    background: {{dangerSoft}};
    color: {{danger}};
}

QPushButton {
    min-height: {{controlContentHeightMedium}}px;
    max-height: {{controlHeightMedium}}px;
    padding: 0 {{controlPaddingX}}px;
    border: 1px solid {{borderStrong}};
    border-radius: {{buttonRadius}}px;
    background: {{surface}};
    color: {{text}};
    font-weight: 500;
}

QPushButton:hover {
    background: {{surfaceBrand}};
    border-color: {{brandHover}};
    color: {{linkHover}};
}

QPushButton:pressed {
    background: {{brandSoft}};
    border-color: {{brandActive}};
    color: {{brandActive}};
}

QPushButton:disabled {
    background: {{surfaceMuted}};
    border-color: {{border}};
    color: {{textDisabled}};
}

QPushButton[ngstdButtonVariant="primary"] {
    background: {{brand}};
    border-color: {{brand}};
    color: {{white}};
}

QPushButton[ngstdButtonVariant="primary"]:hover {
    background: {{brandHover}};
    border-color: {{brandHover}};
    color: {{white}};
}

QPushButton[ngstdButtonVariant="primary"]:pressed {
    background: {{brandActive}};
    border-color: {{brandActive}};
    color: {{white}};
}

QPushButton[ngstdButtonVariant="secondary"] {
    background: {{surface}};
    border-color: {{borderStrong}};
    color: {{text}};
}

QPushButton[ngstdButtonVariant="secondary"]:hover {
    background: {{surfaceBrand}};
    border-color: {{brandHover}};
    color: {{linkHover}};
}

QPushButton[ngstdButtonVariant="secondary"]:pressed {
    background: {{brandSoft}};
    border-color: {{brandActive}};
    color: {{brandActive}};
}

QPushButton[ngstdButtonVariant="text"] {
    border-color: transparent;
    background: transparent;
    color: {{text}};
}

QPushButton[ngstdButtonVariant="text"]:hover {
    border-color: {{borderStrong}};
    background: transparent;
    color: {{linkHover}};
}

QPushButton[ngstdButtonVariant="text"]:pressed {
    border-color: {{brandActive}};
    background: {{brandSoft}};
    color: {{brandActive}};
}

QPushButton[ngstdButtonVariant="ghost"] {
    background: transparent;
    border-color: transparent;
    color: {{link}};
}

QPushButton[ngstdButtonVariant="ghost"]:hover {
    background: {{surfaceBrand}};
    border-color: transparent;
    color: {{linkHover}};
}

QPushButton[ngstdButtonVariant="ghost"]:pressed {
    background: {{brandSoft}};
    border-color: transparent;
    color: {{brandActive}};
}

QPushButton[ngstdButtonVariant="danger"] {
    background: {{surface}};
    border-color: {{danger}};
    color: {{danger}};
}

QPushButton[ngstdButtonVariant="danger"]:hover {
    background: {{dangerSoft}};
    border-color: {{danger}};
    color: {{danger}};
}

QPushButton[ngstdButtonVariant="danger"]:pressed {
    background: {{dangerAction}};
    border-color: {{dangerAction}};
    color: {{white}};
}

QPushButton[ngstdButtonVariant="hero"] {
    min-height: {{controlHeightMedium}}px;
    max-height: {{controlHeightMedium}}px;
    border: 0;
    background: qlineargradient(
        x1: 0, y1: 1, x2: 1, y2: 0,
        stop: 0 {{heroGradientStart}},
        stop: 1 {{heroGradientEnd}}
    );
    color: {{white}};
}

QPushButton[ngstdButtonVariant="hero"]:hover {
    background: qlineargradient(
        x1: 0, y1: 1, x2: 1, y2: 0,
        stop: 0 {{heroGradientHoverStart}},
        stop: 1 {{heroGradientHoverEnd}}
    );
    color: {{white}};
}

QPushButton[ngstdButtonVariant="hero"]:pressed {
    background: qlineargradient(
        x1: 0, y1: 1, x2: 1, y2: 0,
        stop: 0 {{heroGradientActiveStart}},
        stop: 1 {{heroGradientActiveEnd}}
    );
    color: {{white}};
}

QPushButton[ngstdButtonVariant="trial"] {
    min-height: 44px;
    max-height: 44px;
    padding: 0 30px;
    border: 0;
    background: qlineargradient(
        x1: 0, y1: 1, x2: 1, y2: 0,
        stop: 0 {{trialGradientStart}},
        stop: 1 {{trialGradientEnd}}
    );
    color: {{trialText}};
    font-weight: 700;
}

QPushButton[ngstdButtonVariant="trial"]:hover,
QPushButton[ngstdButtonVariant="trial"]:pressed {
    background: qlineargradient(
        x1: 0, y1: 1, x2: 1, y2: 0,
        stop: 0 {{trialGradientHoverStart}},
        stop: 1 {{trialGradientHoverEnd}}
    );
    color: {{trialText}};
}

QPushButton[ngstdButtonVariant="dataFilled"] {
    min-height: {{controlContentHeightLarge}}px;
    max-height: {{controlHeightLarge}}px;
    padding: 0 22px;
    border: 0;
    border-radius: {{fieldRadius}}px;
    background: {{dataActionBackground}};
    color: {{dataActionText}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 500;
}

QPushButton[ngstdButtonVariant="dataFilled"]:hover {
    background: {{dataActionHoverBackground}};
    color: {{dataActionText}};
}

QPushButton[ngstdButtonVariant="dataFilled"]:pressed {
    background: {{dataActionPressedBackground}};
    color: {{dataActionText}};
}

QPushButton[ngstdButtonVariant="dataOutline"] {
    min-height: {{controlContentHeightLarge}}px;
    max-height: {{controlHeightLarge}}px;
    padding: 0 22px;
    border: 1px solid {{dataActionBackground}};
    border-radius: {{fieldRadius}}px;
    background: transparent;
    color: {{dataActionBackground}};
    font-family: "{{qtHeadingFamily}}", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 500;
}

QPushButton[ngstdButtonVariant="dataOutline"]:hover {
    background: {{dataOutlineHoverBackground}};
    border-color: {{dataActionBackground}};
    color: {{dataActionBackground}};
}

QPushButton[ngstdButtonVariant="dataOutline"]:pressed {
    background: {{dataOutlinePressedBackground}};
    border-color: {{dataActionBackground}};
    color: {{dataActionBackground}};
}

QPushButton[ngstdButtonVariant="onBrand"] {
    background: {{corporateText}};
    border-color: {{corporateText}};
    color: {{corporateActionText}};
}

QPushButton[ngstdButtonVariant="onBrand"]:hover {
    background: transparent;
    border-color: {{corporateText}};
    color: {{corporateText}};
}

QPushButton[ngstdButtonVariant="onBrand"]:pressed {
    background: {{corporateSurfaceHover}};
    border-color: {{corporateText}};
    color: {{corporateText}};
}

QPushButton[ngstdButtonVariant="onBrandSecondary"] {
    background: transparent;
    border-color: {{corporateBorderSecondary}};
    color: {{corporateText}};
}

QPushButton[ngstdButtonVariant="onBrandSecondary"]:hover {
    background: {{corporateSurfaceHover}};
    border-color: {{corporateText}};
    color: {{corporateText}};
}

QPushButton[ngstdButtonVariant="onBrandSecondary"]:pressed {
    background: {{corporateSurfaceActive}};
    border-color: {{corporateText}};
    color: {{corporateText}};
}

QPushButton[ngstdButtonVariant="photo"] {
    background: transparent;
    border-color: {{fieldworkText}};
    color: {{fieldworkText}};
}

QPushButton[ngstdButtonVariant="photo"]:hover {
    background: {{fieldworkSurfaceHover}};
    border-color: transparent;
    color: {{fieldworkText}};
}

QPushButton[ngstdButtonVariant="photo"]:pressed {
    background: {{fieldworkSurfaceActive}};
    border-color: transparent;
    color: {{fieldworkText}};
}

QPushButton[ngstdButtonVariant="photoText"] {
    background: transparent;
    border-color: transparent;
    color: {{fieldworkText}};
}

QPushButton[ngstdButtonVariant="photoText"]:hover {
    background: {{fieldworkTextSurfaceHover}};
    border-color: transparent;
    color: {{fieldworkText}};
}

QPushButton[ngstdButtonVariant="photoText"]:pressed {
    background: {{fieldworkSurfaceHover}};
    border-color: transparent;
    color: {{fieldworkText}};
}

QPushButton:checked {
    background: {{brand}};
    border-color: {{brand}};
    color: {{white}};
}

QPushButton:checked:hover {
    background: {{brandHover}};
    border-color: {{brandHover}};
    color: {{white}};
}

QPushButton:checked:pressed {
    background: {{brandActive}};
    border-color: {{brandActive}};
    color: {{white}};
}

QToolButton[_ngstdRole="iconButton"],
QPushButton[ngstdButtonVariant="icon"] {
    min-width: {{controlHeightMedium}}px;
    max-width: {{controlHeightMedium}}px;
    min-height: {{controlContentHeightMedium}}px;
    max-height: {{controlHeightMedium}}px;
    padding: 0;
    border-radius: {{buttonRadius}}px;
}

QPushButton[ngstdButtonVariant="icon"]:pressed {
    background: {{brandSoft}};
    border-color: {{brandActive}};
    color: {{brandActive}};
}

QToolButton[_ngstdRole="iconButton"]:checked {
    background: {{brand}};
    border-color: {{brand}};
    color: {{white}};
}

QToolButton[_ngstdRole="iconButton"]:checked:hover {
    background: {{brandHover}};
    border-color: {{brandHover}};
    color: {{white}};
}

QToolButton[_ngstdRole="iconButton"]:pressed,
QToolButton[_ngstdRole="iconButton"]:checked:pressed {
    background: {{brandActive}};
    border-color: {{brandActive}};
    color: {{white}};
}

QPushButton:disabled,
QPushButton[ngstdButtonVariant="primary"]:disabled,
QPushButton[ngstdButtonVariant="secondary"]:disabled,
QPushButton[ngstdButtonVariant="ghost"]:disabled,
QPushButton[ngstdButtonVariant="danger"]:disabled,
QPushButton[ngstdButtonVariant="hero"]:disabled,
QPushButton[ngstdButtonVariant="trial"]:disabled,
QPushButton[ngstdButtonVariant="dataFilled"]:disabled,
QPushButton[ngstdButtonVariant="dataOutline"]:disabled,
QPushButton[ngstdButtonVariant="onBrand"]:disabled,
QPushButton[ngstdButtonVariant="onBrandSecondary"]:disabled,
QPushButton[ngstdButtonVariant="photo"]:disabled,
QPushButton[ngstdButtonVariant="photoText"]:disabled {
    background: {{surfaceMuted}};
    border-color: {{border}};
    color: {{textDisabled}};
}

QFrame[_ngstdRole="disclosure"] {
    border: 0;
    background: transparent;
}

QToolButton[_ngstdRole="disclosure"] {
    min-height: {{disclosureHeaderHeight}}px;
    padding: 0;
    border: 0;
    border-radius: {{buttonRadius}}px;
    background: transparent;
    color: {{textSecondary}};
    font-weight: 500;
    text-align: left;
}

QToolButton[_ngstdRole="disclosure"]:hover {
    background: {{surfaceNested}};
    color: {{text}};
}

QToolButton[_ngstdRole="disclosure"]:pressed {
    background: {{brandSoft}};
    border-color: {{brandActive}};
    color: {{brandActive}};
}

QToolButton[_ngstdRole="disclosure"]:checked {
    background: {{surfaceNested}};
    color: {{text}};
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QLabel[_ngstdRole="disclosureTitle"] {
    background: transparent;
    color: {{textSecondary}};
    font-weight: 500;
}

QToolButton[_ngstdRole="disclosure"]:hover
QLabel[_ngstdRole="disclosureTitle"],
QToolButton[_ngstdRole="disclosure"]:checked
QLabel[_ngstdRole="disclosureTitle"] {
